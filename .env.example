# Copy to .env.local and fill in real values. Never commit .env / .env.local.
# All EXPO_PUBLIC_* values are embedded in the client bundle, so only put
# publishable values here (the Supabase anon key is fine; never a service key).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_APPLE_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXXX
EXPO_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=your.package.name
